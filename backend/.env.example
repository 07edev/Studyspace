# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Atlas or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/studyspace
# Use a long random value (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
# Comma separated Google OAuth client ids accepted for /auth/google (leave empty to disable)
GOOGLE_CLIENT_IDS=
CORS_ORIGINS=http://localhost:5173
