# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Atlas or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/studyspace
# Use a long random value (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
# Comma separated Google OAuth client ids accepted for /auth/google (leave empty to disable).
# See docs/GOOGLE_SIGNIN_SETUP.md
GOOGLE_CLIENT_IDS=
# Email for OTP codes, via any SMTP server. Required in production. When empty (development
# only) codes are printed to the server log instead of being emailed.
#   Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<SMTP login>, SMTP_PASS=<SMTP key>
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail>, SMTP_PASS=<App Password>
# See docs/EMAIL_SETUP.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StudySpace <no-reply@example.com>
# S3-compatible file storage (AWS S3 or MinIO). In production use workload identity or
# configure both access-key variables; never commit their values.
FILE_S3_BUCKET=
FILE_S3_REGION=us-east-1
FILE_S3_ENDPOINT=
FILE_S3_FORCE_PATH_STYLE=
FILE_S3_ACCESS_KEY_ID=
FILE_S3_SECRET_ACCESS_KEY=
FILE_UPLOAD_URL_TTL_SECONDS=600
FILE_ACCESS_URL_TTL_SECONDS=300
FILE_DAILY_QUOTA_BYTES=100000000
# ClamAV daemon. Production startup requires a configured scanner and bucket.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:5173
